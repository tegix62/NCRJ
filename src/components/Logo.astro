---
// The Collaborative's mark (leaf sprig with a bumblebee). The drawing lives in
// src/assets/logo.mjs so it is the same everywhere it appears.
import { LOGO_VIEWBOX, LOGO_INNER } from '../assets/logo.mjs';

interface Props {
  size?: number;
}
const { size = 56 } = Astro.props;
---

<svg width={size} height={size} viewBox={LOGO_VIEWBOX} aria-hidden="true" set:html={LOGO_INNER} />
