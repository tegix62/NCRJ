---
// Click-to-play YouTube video. Nothing loads from YouTube until the visitor
// presses play (privacy rule in CLAUDE.md), and then only from the
// youtube-nocookie.com domain. Without JavaScript, the link still works.
interface Props {
  title: string;
  youtubeId: string;
}
const { title, youtubeId } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
---

<figure class="video">
  <div class="frame" data-youtube-id={youtubeId} data-title={title}>
    <button type="button" class="play" aria-label={`Play video: ${title}`}>
      <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
        <rect width="68" height="48" rx="12" fill="currentColor" />
        <path d="M27 15 L47 24 L27 33 Z" fill="var(--color-bg)" />
      </svg>
      <span>Play video</span>
    </button>
  </div>
  <figcaption>
    <h3>{title}</h3>
    <p>Plays from YouTube. <a href={watchUrl}>Watch on YouTube</a></p>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.video .frame').forEach((frame) => {
    frame.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.youtubeId}?autoplay=1`;
      iframe.title = frame.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video { margin: 0; }
  .frame {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden;
    background: var(--color-green); border-radius: var(--radius);
  }
  .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .play {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: var(--space-2);
    width: 100%; border: 0; cursor: pointer; background: transparent; color: var(--color-rust);
    font: 500 0.95rem var(--font-body);
  }
  .play span { color: var(--color-bg); }
  .play:hover svg, .play:focus-visible svg { color: var(--color-rust-text); }
  .play:focus-visible { outline: 3px solid var(--color-rust); outline-offset: -3px; }
  figcaption h3 { margin: var(--space-3) 0 var(--space-1); font-size: 1.25rem; }
  figcaption p { margin: 0; color: var(--color-muted); font-size: 0.9rem; }
</style>
