---
// Shared heading block for inner pages.
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<header class="page-intro">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-intro { background: var(--color-cream); padding-block: var(--space-5); border-bottom: 1px solid var(--color-border); }
  .eyebrow { margin: 0; }
  h1 { margin: var(--space-2) 0; font-weight: 700; font-size: clamp(2rem, 5vw, 3rem); }
  .lede { max-width: 40rem; margin: 0; font-size: 1.15rem; color: var(--color-muted); }
</style>
