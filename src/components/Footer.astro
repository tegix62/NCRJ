---
import { SITE } from '../site';
---

<footer class="site-footer">
  <div class="container">
    <p>© {new Date().getFullYear()} {SITE.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6); padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-family: var(--font-ui); font-size: 0.9rem; color: var(--color-muted);
  }
</style>
