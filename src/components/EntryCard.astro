---
import VerificationBadge from './VerificationBadge.astro';
import { ENTRY_TYPES, placeAndPeriod, type ArchivistEntry } from '../lib/archivist';

interface Props {
  entry: ArchivistEntry;
}

const { entry } = Astro.props;
const meta = placeAndPeriod(entry);
---

<article class="entry-card">
  <p class="eyebrow">{ENTRY_TYPES[entry.entryType]}</p>
  <h3><a href={`/archivist/${entry.slug}/`}>{entry.title}</a></h3>
  {meta && <p class="meta">{meta}</p>}
  <p class="summary">{entry.summary}</p>
  <VerificationBadge status={entry.verificationStatus} />
</article>

<style>
  .entry-card {
    position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2);
    padding: var(--space-4); background: var(--color-bg);
    border: 1px solid var(--color-border); border-radius: var(--radius);
  }
  .entry-card:hover { border-color: var(--color-rust); }
  .eyebrow { margin: 0; font-size: 0.72rem; letter-spacing: 0.2em; }
  h3 { margin: 0; font-size: 1.35rem; }
  h3 a { color: var(--color-text); text-decoration: none; }
  /* Whole card is clickable via the title link */
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:focus-visible { outline: none; }
  .entry-card:has(a:focus-visible) { outline: 2px solid var(--color-rust); outline-offset: 2px; }
  .meta { margin: 0; font-size: 0.9rem; color: var(--color-muted); }
  .summary { margin: 0 0 var(--space-2); line-height: 1.5; }
</style>
