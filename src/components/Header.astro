---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, NAV, CONNECT } from '../site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const [lockupTop, ...lockupRest] = SITE.lockup;
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${SITE.shortName}, home`}>
      <Logo />
      <span class="lockup">
        <span class="lockup-top">{lockupTop}</span>
        {lockupRest.map((line) => <span>{line}</span>)}
      </span>
    </a>

    <!-- <details> gives a working mobile menu with no JavaScript. -->
    <details class="nav-toggle">
      <summary><Icon name="menu" /><span class="visually-hidden">Menu</span></summary>
      <nav aria-label="Main">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
        <a class="connect" href={CONNECT.href}>{CONNECT.label}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-3) clamp(1rem, 4vw, 4rem);
  }

  .brand { display: flex; align-items: center; gap: var(--space-3); color: var(--color-text); text-decoration: none; }
  .brand :global(svg) { flex: none; }
  .lockup { display: flex; flex-direction: column; white-space: nowrap; font-family: var(--font-display); font-size: 0.95rem; line-height: 1.2; }
  .lockup-top { text-transform: uppercase; letter-spacing: 0.04em; font-size: 1.1rem; }

  summary {
    list-style: none; cursor: pointer; padding: var(--space-2);
    border: 1px solid var(--color-border); border-radius: var(--radius); display: flex;
  }
  summary::-webkit-details-marker { display: none; }

  nav ul { list-style: none; margin: 0; padding: 0; }
  nav ul a {
    color: var(--color-text); text-decoration: none; font-size: 0.95rem; white-space: nowrap;
    padding-block: var(--space-2); border-bottom: 2px solid transparent;
  }
  nav ul a:hover { color: var(--color-rust-text); }
  nav ul a[aria-current='page'] { color: var(--color-rust-text); border-bottom-color: var(--color-rust-text); }

  .connect {
    display: inline-block; padding: 0.75rem clamp(1.5rem, 2.5vw, 3rem); border-radius: 12px; white-space: nowrap;
    background: var(--color-green); color: #fff; text-decoration: none; font-size: 0.95rem;
  }
  .connect:hover { background: #142822; }

  /* Small screens: dropdown panel */
  @media (max-width: 84.99rem) {
    .nav-toggle { position: static; }
    .site-header { position: relative; }
    .nav-toggle[open] nav {
      position: absolute; inset: 100% 0 auto; z-index: 10;
      background: var(--color-bg); border-bottom: 1px solid var(--color-border);
      padding: var(--space-3) clamp(1rem, 4vw, 4rem) var(--space-4);
      display: flex; flex-direction: column; gap: var(--space-3);
    }
    nav ul { display: flex; flex-direction: column; gap: var(--space-1); }
    nav ul a { display: inline-block; }
    .connect { align-self: flex-start; }
  }
  @media (max-width: 30rem) {
    .lockup { font-size: 0.78rem; }
    .lockup-top { font-size: 0.9rem; }
    .brand :global(svg) { width: 40px; height: 40px; }
  }

  /* Wide screens: full inline nav, toggle hidden */
  @media (min-width: 85rem) {
    summary { display: none; }
    .nav-toggle nav { display: flex; align-items: center; gap: clamp(1.5rem, 2vw, 2.5rem); }
    nav ul { display: flex; gap: clamp(1.1rem, 1.8vw, 2.5rem); }
  }
</style>

<script is:inline>
  // On wide screens the nav must always be visible, so keep the <details> open there.
  (() => {
    const d = document.querySelector('.nav-toggle');
    const mq = matchMedia('(min-width: 85rem)');
    const sync = () => { if (mq.matches) d.open = true; };
    sync();
    mq.addEventListener('change', sync);
  })();
</script>
