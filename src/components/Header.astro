---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, NAV, CONNECT } from '../site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const [lockupTop, ...lockupRest] = SITE.lockup;
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${SITE.shortName}, home`}>
      <Logo size={64} />
      <span class="lockup">
        <span class="lockup-top">{lockupTop}</span>
        <!-- Stacked on small screens; one longer line on laptops and up. -->
        <span class="lockup-sub">{lockupRest.map((line, i) => <>{i > 0 && ' '}<span>{line}</span></>)}</span>
      </span>
    </a>

    <!-- <details> gives a working mobile menu with no JavaScript. -->
    <details class="nav-toggle">
      <summary><Icon name="menu" /><span class="visually-hidden">Menu</span></summary>
      <nav aria-label="Main">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
        <a class="connect" href={CONNECT.href}>{CONNECT.label}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-3) clamp(1rem, 4vw, 4rem);
    /* Line up with the page content on very wide screens */
    max-width: calc(var(--width-wide) + 8rem); margin-inline: auto;
  }

  .brand { display: flex; align-items: center; gap: var(--space-3); color: var(--color-text); text-decoration: none; }
  .brand :global(svg) { flex: none; }
  .lockup { display: flex; flex-direction: column; white-space: nowrap; font-family: var(--font-display); font-size: 1.1rem; line-height: 1.25; }
  .lockup-top { text-transform: uppercase; letter-spacing: 0.05em; font-size: 1.4rem; }
  .lockup-sub > span { display: block; }
  @media (min-width: 73rem) {
    .lockup-sub > span { display: inline; }
    .lockup-top { font-size: 1.6rem; }
  }

  summary {
    list-style: none; cursor: pointer; padding: var(--space-2);
    border: 1px solid var(--color-border); border-radius: var(--radius); display: flex;
  }
  summary::-webkit-details-marker { display: none; }

  nav ul { list-style: none; margin: 0; padding: 0; }
  nav ul a {
    color: var(--color-text); text-decoration: none; font-size: 1.05rem; white-space: nowrap;
    padding-block: var(--space-2); border-bottom: 2px solid transparent;
  }
  nav ul a:hover { color: var(--color-rust-text); }
  nav ul a[aria-current='page'] { color: var(--color-rust-text); border-bottom-color: var(--color-rust-text); }

  .connect {
    display: inline-block; padding: 0.85rem clamp(1.75rem, 2.8vw, 3.25rem); border-radius: 12px; white-space: nowrap;
    background: var(--color-green); color: #fff; text-decoration: none; font-size: 1.1rem; font-weight: 500;
  }
  .connect:hover { background: #142822; }

  /* Small screens: dropdown panel */
  @media (max-width: 72.99rem) {
    .nav-toggle { position: static; }
    .site-header { position: relative; }
    .nav-toggle[open] nav {
      position: absolute; inset: 100% 0 auto; z-index: 10;
      background: var(--color-bg); border-bottom: 1px solid var(--color-border);
      padding: var(--space-3) clamp(1rem, 4vw, 4rem) var(--space-4);
      display: flex; flex-direction: column; gap: var(--space-3);
    }
    nav ul { display: flex; flex-direction: column; gap: var(--space-1); }
    nav ul a { display: inline-block; }
    .connect { align-self: flex-start; }
  }
  @media (max-width: 40rem) {
    .lockup { font-size: 0.85rem; }
    .lockup-top { font-size: 1rem; }
    .brand :global(svg) { width: 44px; height: 44px; }
  }
  @media (max-width: 26rem) {
    .bar { gap: var(--space-2); }
    .brand { gap: var(--space-2); }
    .lockup { font-size: 0.8rem; }
    .lockup-top { font-size: 0.96rem; }
    .brand :global(svg) { width: 40px; height: 40px; }
  }
  @media (max-width: 23.5rem) {
    .lockup { font-size: 0.74rem; }
    .lockup-top { font-size: 0.88rem; }
    .brand :global(svg) { width: 36px; height: 36px; }
  }
  @media (max-width: 21rem) {
    .lockup { font-size: 0.66rem; }
    .lockup-top { font-size: 0.8rem; }
    .brand :global(svg) { width: 30px; height: 30px; }
  }

  /* Laptops and up: logo on the first row, the full menu on its own row below,
     with the page links spread evenly. The toggle is hidden. */
  @media (min-width: 73rem) {
    summary { display: none; }
    .bar { flex-wrap: wrap; row-gap: var(--space-2); padding-bottom: var(--space-2); }
    .nav-toggle { flex-basis: 100%; }
    .nav-toggle nav { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); }
    nav ul { display: flex; flex: 1; justify-content: space-between; gap: var(--space-3); }
  }
</style>

<script is:inline>
  // On laptops and up the nav must always be visible, so keep the <details> open there.
  (() => {
    const d = document.querySelector('.nav-toggle');
    const mq = matchMedia('(min-width: 73rem)');
    const sync = () => { if (mq.matches) d.open = true; };
    sync();
    mq.addEventListener('change', sync);
  })();
</script>
