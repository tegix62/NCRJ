---
import { SITE, NAV } from '../site';
---

<header class="site-header">
  <div class="container">
    <a class="site-name" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); font-family: var(--font-ui); }
  .container {
    display: flex; flex-wrap: wrap; gap: var(--space-3);
    align-items: center; justify-content: space-between;
    padding-block: var(--space-3);
  }
  .site-name { font-weight: 700; color: var(--color-text); text-decoration: none; }
  nav { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  nav a { color: var(--color-muted); text-decoration: none; }
  nav a:hover { color: var(--color-text); }
</style>
