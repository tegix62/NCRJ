---
// One shareable graphic with its description, credit line, and a text version.
// The image links to the full-size file so visitors can open or enlarge it.
import Icon from './Icon.astro';
import type { ActionResource } from '../data/action-resources';

interface Props {
  resource: ActionResource;
  /** Smaller layout for use inside a card. */
  compact?: boolean;
}
const { resource: r, compact = false } = Astro.props;

const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const creditHtml = escape(r.credit).replace(/\*([^*]+)\*/g, '<em>$1</em>');
const t = r.textVersion;
---

<article class:list={['ar', { compact }]}>
  <a class="ar-image" href={r.image} aria-label={`Open the full-size graphic: ${r.title}`}>
    <img src={r.image} alt={r.imageAlt} width={r.imageWidth} height={r.imageHeight} loading="lazy" />
  </a>
  <div class="ar-body">
    <h3>{r.title}</h3>
    <p class="desc">{r.description}</p>
    <p class="credit" set:html={creditHtml} />
    <p><a class="open" href={r.image}>Open the full graphic <Icon name="arrow-right" size={16} /></a></p>

    {t && !compact && (
      <details class="text-version">
        <summary>Read the text of this graphic</summary>
        <h4>{t.title}</h4>
        <p>{t.strip}</p>
        <p>{t.lede}</p>
        <h4>{t.was.heading}</h4>
        <p>{t.was.intro}</p>
        <ul>{t.was.items.map((i) => <li>{i.text}</li>)}</ul>
        <h4>{t.now.heading}</h4>
        <p>{t.now.intro}</p>
        <ul>{t.now.items.map((i) => <li>{i.text}</li>)}</ul>
        <h4>{t.why.heading}</h4>
        <p>{t.why.text}</p>
        <ul>{t.why.items.map((i) => <li>{i.text}</li>)}</ul>
        <p>{t.why.note}</p>
      </details>
    )}
  </div>
</article>

<style>
  .ar { display: grid; gap: var(--space-4); align-items: start; }
  @media (min-width: 48rem) { .ar:not(.compact) { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: var(--space-5); } }
  .ar-image { display: block; border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; background: var(--color-sand); }
  .ar-image:focus-visible { outline: 3px solid var(--color-rust); outline-offset: 2px; }
  .ar-image img { display: block; width: 100%; height: auto; }
  .ar-body h3 { margin: 0 0 var(--space-2); font-weight: 700; font-size: clamp(1.4rem, 2.6vw, 1.8rem); }
  .desc { margin: 0 0 var(--space-3); line-height: 1.6; }
  .credit { margin: 0 0 var(--space-3); font-size: 0.9rem; line-height: 1.5; color: var(--color-muted); }
  .open { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 600; color: var(--color-rust-text); }
  .text-version { margin-top: var(--space-4); padding: var(--space-3) var(--space-4); background: var(--color-cream); border: 1px solid var(--color-border); border-radius: var(--radius); }
  .text-version summary { cursor: pointer; font-weight: 600; }
  .text-version h4 { margin: var(--space-4) 0 var(--space-1); font-family: var(--font-display); font-size: 1.1rem; }
  .text-version p { margin: 0 0 var(--space-2); font-size: 0.95rem; }
  .text-version ul { margin: 0 0 var(--space-2); padding-left: 1.25rem; font-size: 0.95rem; display: grid; gap: var(--space-1); }

  /* Inside a card: image on top at a modest size, shorter text */
  .compact { gap: var(--space-3); }
  .compact .ar-image { width: min(100%, 11rem); }
  .compact .ar-body h3 { font-size: 1.1rem; line-height: 1.3; }
  .compact .desc { font-size: 0.9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .compact .credit { font-size: 0.8rem; }
</style>
