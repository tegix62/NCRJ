---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../site';
import { formatEventTime } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { tags, title, excerpt, featureImage, featureImageAlt, event } = post.data;
const primaryTag = tags[0];
---

<article class="post-card">
  {featureImage && (
    <a class="thumb" href={`/news/${post.id}/`} tabindex="-1" aria-hidden="true">
      <img src={featureImage} alt={featureImageAlt ?? ''} loading="lazy" />
    </a>
  )}
  <div class="body">
    <a class="eyebrow" href={`/category/${primaryTag}/`}>{CATEGORIES[primaryTag]?.name ?? primaryTag}</a>
    <h3><a href={`/news/${post.id}/`}>{title}</a></h3>
    {event && <p class="when">{formatEventTime(event.startsAt)} · {event.location}</p>}
    <p>{excerpt}</p>
  </div>
</article>

<style>
  .post-card {
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .thumb { display: block; aspect-ratio: 4 / 3; background: var(--color-sand); }
  .thumb img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .body { padding: var(--space-4); }
  .eyebrow { text-decoration: none; }
  h3 { margin: var(--space-2) 0; }
  h3 a { color: var(--color-text); text-decoration: none; }
  .when { margin: 0 0 var(--space-2); font-weight: 600; color: var(--color-text); }
  p { margin: 0; color: var(--color-muted); }
</style>
