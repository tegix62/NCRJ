---
import Default from '../layouts/Default.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Default title="Page not found">
  <PageIntro eyebrow="404" title="Page not found" lede="This page doesn't exist or has moved.">
    <p class="back"><a class="button" href="/">Go to the homepage</a></p>
  </PageIntro>
</Default>

<style>
  .back { margin-top: var(--space-4); }
</style>
