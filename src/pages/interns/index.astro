---
// Interns, graduate assistants, and volunteers. Linked from the Leadership page;
// not in the main menu. Placeholder until the team has names and bios to share.
import Default from '../../layouts/Default.astro';
import PageIntro from '../../components/PageIntro.astro';
---

<Default title="Interns, GAs, and Volunteers" description="The interns, graduate assistants, and volunteers who support the Collaborative's work.">
  <PageIntro
    eyebrow="Students. Emerging Leaders. Community Builders."
    title="Interns, GAs, and Volunteers"
    lede="Our interns, graduate assistants, and volunteers play a vital role in the Collaborative’s work."
  />
  <div class="content">
    <p class="coming-soon" role="note">Updates coming soon.</p>
  </div>
</Default>

<style>
  .content { padding-block: var(--space-5); }
  .coming-soon {
    display: inline-block; margin: 0; padding: var(--space-2) var(--space-3);
    background: var(--color-cream); border: 1px solid var(--color-border); border-radius: var(--radius);
    font-size: 0.95rem; color: var(--color-muted);
  }
</style>
