---
// Maps to Ghost's index.hbs (the post list).
import Default from '../../layouts/Default.astro';
import PageIntro from '../../components/PageIntro.astro';
import PostGrid from '../../components/PostGrid.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Default title="News & Events">
  <PageIntro eyebrow="Updates" title="News & Events" lede="Gatherings, dialogues, and updates from the Collaborative." />
  <div class="container list">
    {posts.length ? <PostGrid posts={posts} /> : <p>Nothing posted yet. Check back soon.</p>}
  </div>
</Default>

<style>
  .list { padding-block: var(--space-5); }
</style>
