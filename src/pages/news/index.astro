---
// Maps to Ghost's index.hbs (the post list). Pinned posts are shown first, in a larger block.
import Default from '../../layouts/Default.astro';
import PageIntro from '../../components/PageIntro.astro';
import PostGrid from '../../components/PostGrid.astro';
import ActionResourceCard from '../../components/ActionResourceCard.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES } from '../../site';
import { ACTION_RESOURCES } from '../../data/action-resources';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const pinned = posts.filter((p) => p.data.pinned);
const others = posts.filter((p) => !p.data.pinned);
---

<Default title="News & Events">
  <PageIntro eyebrow="Updates" title="News & Events" lede="Gatherings, dialogues, and updates from the Collaborative." />

  {pinned.map((post) => (
    <section class="pinned" aria-label="Pinned announcement">
      <div class="container pinned-inner">
        {post.data.featureImage && (
          <a class="pinned-image" href={`/news/${post.id}/`} tabindex="-1" aria-hidden="true">
            <img src={post.data.featureImage} alt="" />
          </a>
        )}
        <div class="pinned-body">
          <p class="eyebrow"><span class="pin">Pinned</span> · {CATEGORIES[post.data.tags[0]]?.name ?? post.data.tags[0]}</p>
          <h2><a href={`/news/${post.id}/`}>{post.data.title}</a></h2>
          <p class="pinned-text">{post.data.excerpt}</p>
          <div class="pinned-actions">
            {post.data.cta && <a class="button" href={post.data.cta.url}>{post.data.cta.label} <Icon name="arrow-right" size={16} /></a>}
            <a class="text-link" href={`/news/${post.id}/`}>Read more <Icon name="arrow-right" size={16} /></a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <div class="container list">
    <h2 class="section-title">Events and updates</h2>
    {others.length ? <PostGrid posts={others} /> : <p>Nothing posted yet. Check back soon.</p>}
  </div>

  <section class="action" id="action-resources" aria-labelledby="action-heading">
    <div class="container">
      <h2 id="action-heading">Political Education, Public Statements, and Action Resources</h2>
      <div class="action-list">
        {ACTION_RESOURCES.map((r) => <ActionResourceCard resource={r} />)}
      </div>
    </div>
  </section>
</Default>

<style>
  .pinned { background: var(--color-sand); border-bottom: 1px solid var(--color-border); padding-block: var(--space-5); }
  .pinned-inner { display: grid; gap: var(--space-4); align-items: center; }
  @media (min-width: 48rem) { .pinned-inner { grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); gap: var(--space-5); } }
  .pinned-image { display: block; border-radius: var(--radius); overflow: hidden; box-shadow: 0 2px 0 rgba(0, 0, 0, 0.08); }
  .pinned-image img { display: block; width: 100%; height: auto; }
  .eyebrow { margin: 0 0 var(--space-2); }
  .pin { padding: 0.15em 0.6em; border-radius: 999px; background: var(--color-green); color: #fff; letter-spacing: 0.14em; }
  .pinned h2 { margin: 0 0 var(--space-3); font-weight: 700; font-size: clamp(1.7rem, 3.4vw, 2.4rem); }
  .pinned h2 a { color: var(--color-text); text-decoration: none; }
  .pinned-text { margin: 0 0 var(--space-4); max-width: 38rem; font-size: 1.1rem; line-height: 1.6; }
  .pinned-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }

  .list { padding-block: var(--space-5); }
  .section-title { margin: 0 0 var(--space-4); font-weight: 700; font-size: clamp(1.5rem, 3vw, 2rem); }

  .action { background: var(--color-cream); border-top: 1px solid var(--color-border); padding-block: var(--space-5) var(--space-6); }
  .action h2 { margin: 0 0 var(--space-4); font-weight: 700; font-size: clamp(1.5rem, 3vw, 2rem); }
  .action-list { display: grid; gap: var(--space-5); }
</style>
