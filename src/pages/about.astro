---
// Maps to Ghost's page.hbs (a static page).
import Default from '../layouts/Default.astro';
import PageIntro from '../components/PageIntro.astro';
import { SITE } from '../site';
import { MEMBERS } from '../data/members';

// The original twelve founders of reproductive justice, as listed by Marissa.
const RJ_FOUNDERS = [
  'Dr. Toni M. Bond Leonard',
  'Reverend Alma Crawford',
  'Evelyn S. Field',
  'Terri James',
  'Bisola Marignay',
  'Cassandra McConnell',
  'Cynthia Newbille',
  'Loretta J. Ross',
  'Elizabeth Terry',
  'Mable Thomas',
  'Winnette P. Willis',
  'Kim Youngblood',
];
---

<Default title="About">
  <PageIntro eyebrow="About" title="About the Collaborative" lede={SITE.description} />
  <div class="content about">
    <section aria-labelledby="mission-heading">
      <h2 id="mission-heading">Mission</h2>
      <p>
        The {SITE.name} is all of us—educators, clinicians, policy advocates, students, allied professionals, and
        more. Our mission is to advance reproductive justice and abolitionist framework by providing education,
        training, and advocacy tools that transform social work and the broader helping professions. We strive to
        ensure that reproductive justice and abolition are embedded in the core competencies of these fields,
        equipping professionals to challenge systemic harm and build community-centered models of care.
      </p>
    </section>

    <section aria-labelledby="vision-heading">
      <h2 id="vision-heading">Vision</h2>
      <p>
        We envision a future where reproductive justice and abolition are foundational to social work and the helping
        professions, shaping policies, education, and practice that prioritize liberation, equity, and healing. Through
        collective action and innovation, we are dismantling oppressive systems and reimagining care work as a force
        for transformative justice that centers Black and marginalized communities.
      </p>
    </section>

    <section aria-labelledby="tenets-heading">
      <h2 id="tenets-heading">The Tenets of Reproductive Justice</h2>
      <p>
        Reproductive justice is a contemporary framework for activism and for thinking about the experience of
        reproduction. It is also a political movement that splices reproductive rights with social justice to achieve
        reproductive justice. The definition of reproductive justice goes beyond the pro-choice/pro-life debate and has
        three primary principles:
      </p>
      <ol class="tenets">
        <li>The right not to have a child</li>
        <li>The right to have a child</li>
        <li>The right to parent children in safe and healthy environments</li>
      </ol>
      <p>In addition, reproductive justice demands sexual autonomy and gender freedom for every human being.</p>

      <h3 class="founders-heading">The original twelve founders of reproductive justice</h3>
      <ul class="founders">
        {RJ_FOUNDERS.map((name) => <li>{name}</li>)}
      </ul>
    </section>

    <section aria-labelledby="members-heading">
      <h2 id="members-heading">Members</h2>
      <ul class="members">
        {MEMBERS.map((m) => (
          <li>
            <span class="name">{m.name}{m.credentials && <span class="credentials">, {m.credentials}</span>}</span>
            {m.role && <span class="role">{m.role}</span>}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Default>

<style>
  .about { padding-block: var(--space-5); }
  h2 { margin: 0 0 var(--space-4); font-size: 1.75rem; }
  section + section { margin-top: var(--space-6); }
  section p { margin: 0; font-size: 1.05rem; line-height: 1.65; }
  section p + p, .tenets + p { margin-top: var(--space-3); }
  .founders-heading { margin: var(--space-5) 0 var(--space-3); font-size: 1.25rem; }
  .founders {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--space-2) var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .founders li { padding-left: var(--space-3); border-left: 2px solid var(--color-rust); }
  .tenets { list-style: none; counter-reset: tenet; margin: var(--space-4) 0; padding: 0; display: grid; gap: var(--space-2); }
  .tenets li {
    counter-increment: tenet; display: grid; grid-template-columns: 2.25rem 1fr; align-items: center; gap: var(--space-3);
    padding: var(--space-3); background: var(--color-cream); border-left: 3px solid var(--color-rust);
    font-family: var(--font-display); font-size: 1.15rem;
  }
  .tenets li::before {
    content: counter(tenet); width: 2.25rem; height: 2.25rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--color-icon-bg); font-weight: 700;
  }
  .members { list-style: none; margin: 0; padding: 0; }
  #members-heading { padding-bottom: var(--space-3); border-bottom: 1px solid var(--color-border); }
  .members li { display: grid; gap: 0.15rem; padding-block: var(--space-3); }
  .name { font-weight: 600; }
  .credentials { font-weight: 400; color: var(--color-muted); }
  .role { color: var(--color-rust-text); font-size: 0.95rem; }
</style>
