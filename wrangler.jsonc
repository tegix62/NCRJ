// Cloudflare Workers config: serve the static Astro build from dist/.
{
  "name": "ncrj",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required by Cloudflare's branch preview builds (`wrangler preview`). Can stay empty.
  "previews": {}
}
